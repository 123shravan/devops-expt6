pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out project from GitHub...'
            }
        }

        stage('Build') {
            steps {
                echo 'Build started...'
                bat 'dir'
                echo 'Build completed successfully!'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing required web files...'

                bat 'powershell -NoProfile -Command "if (!(Test-Path ''devops expt6/index.html'')) { exit 1 }; if (!(Test-Path ''devops expt6/style.css'')) { exit 1 }; if (!(Test-Path ''devops expt6/script.js'')) { exit 1 }"'

                echo 'All required files are present!'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying website to IIS...'

                bat 'xcopy /Y /I "devops expt6/index.html" "C:/inetpub/wwwroot"'
                bat 'xcopy /Y /I "devops expt6/style.css" "C:/inetpub/wwwroot"'
                bat 'xcopy /Y /I "devops expt6/script.js" "C:/inetpub/wwwroot"'

                echo 'Deployment completed successfully!'
            }
        }
    }

    post {
        success {
            echo 'CI/CD PIPELINE SUCCESSFUL!'
            echo 'Website deployed to IIS.'
            echo 'Visit: http://localhost/index.html'
        }

        failure {
            echo 'Pipeline failed! Check the console output.'
        }
    }
}