pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                powershell '''
                    Write-Host "Building NovaSpace experiment 06"
                    Get-Item "devops expt6\index.html", "devops expt6\style.css", "devops expt6\script.js" | Format-Table -AutoSize
                '''
            }
        }

        stage('Test') {
            steps {
                powershell '''
                    $files = @(
                        "devops expt6\index.html",
                        "devops expt6\style.css",
                        "devops expt6\script.js"
                    )

                    foreach ($file in $files) {
                        if (-not (Test-Path $file)) {
                            throw "Required file not found: $file"
                        }

                        $item = Get-Item $file
                        if ($item.Length -le 0) {
                            throw "Required file is empty: $file"
                        }
                    }

                    Write-Host "All required web files exist and contain content."
                '''
            }
        }

        stage('Deploy') {
            steps {
                powershell '''
                    $sourceFiles = @(
                        "devops expt6\index.html",
                        "devops expt6\style.css",
                        "devops expt6\script.js"
                    )

                    $destination = "C:\inetpub\wwwroot"
                    foreach ($file in $sourceFiles) {
                        Copy-Item $file $destination -Force
                    }

                    Write-Host "Deployed NovaSpace files to $destination"
                '''
            }
        }
    }
}