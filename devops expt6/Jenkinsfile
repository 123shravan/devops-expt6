pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out project from GitHub...'
            }
        }

        stage('Build') {
            steps {
                echo 'Build started...'
                bat 'dir "devops expt6"'
                echo 'Build completed successfully!'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing web application files...'

                bat '''
                if not exist "devops expt6\\index.html" (
                    echo ERROR: index.html not found
                    exit /b 1
                )

                if not exist "devops expt6\\style.css" (
                    echo ERROR: style.css not found
                    exit /b 1
                )

                if not exist "devops expt6\\script.js" (
                    echo ERROR: script.js not found
                    exit /b 1
                )

                echo All required files found successfully.
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying website to IIS...'

                bat '''
                xcopy /Y /I "devops expt6\\index.html" "C:\\inetpub\\wwwroot\\"
                xcopy /Y /I "devops expt6\\style.css" "C:\\inetpub\\wwwroot\\"
                xcopy /Y /I "devops expt6\\script.js" "C:\\inetpub\\wwwroot\\"
                '''

                echo 'Deployment completed successfully!'
            }
        }
    }

    post {
        success {
            echo '======================================'
            echo 'CI/CD PIPELINE SUCCESSFUL!'
            echo 'Website deployed to IIS.'
            echo 'URL: http://localhost/index.html'
            echo '======================================'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}